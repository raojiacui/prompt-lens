# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/prompt_analyzer
DATABASE_MAX_CONNECTIONS=5

# Auth (IMPORTANT: This secret is used for API Key encryption - keep it safe!)
BETTER_AUTH_SECRET=your-better-auth-secret-here
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-cloudflare-account-id
# Optional. If set, overrides R2_ACCOUNT_ID endpoint construction.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Use your R2 custom domain or public dev URL, without a trailing slash.
R2_PUBLIC_URL=https://cdn.your-domain.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin
ADMIN_EMAILS=admin@example.com,your-email@gmail.com
ADMIN_USER_IDS=

# SMTP (Email - OTP login)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=raojinbo@gmail.com
SMTP_PASS=dljh bdht tvdo dnmz
SMTP_FROM=Prompt Lens <raojinbo@gmail.com>

# AI Providers (system keys)
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_API_KEY=your-openai-api-key
ZHIPU_API_KEY=your-zhipu-api-key
GEMINI_API_KEY=your-gemini-api-key
# Platform free-trial video analysis only; users cannot configure OpenRouter in settings.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_ANALYSIS_MODEL=google/gemini-2.5-flash
# Optional. Defaults to OpenRouter chat completions.
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Audio Transcription (AssemblyAI - Free 1 hour/month)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Background music recognition (AudD: first 300 recognition requests are free after signup)
AUDD_API_TOKEN=your-audd-api-token

# KIE platform key. Used by admins and paid packages that include the target feature. Users can also bring their own KIE key in settings.
KIE_API_KEY=your-kie-api-key
KIE_AI_API_KEY=your-kie-api-key
LEAPERONE_API_KEY=
# Optional override; defaults to https://api.leaper.one
LEAPERONE_API_BASE_URL=
KIE_API_BASE_URL=https://api.kie.ai
KIE_AI_BASE_URL=https://api.kie.ai
KIE_VIDEO_MODEL=wan/2-7-text-to-video
KIE_VEO_MODEL=veo3_fast
KIE_VEO_GENERATE_ENDPOINT=/api/v1/veo/generate
KIE_VEO_STATUS_ENDPOINT=/api/v1/veo/record-info
KIE_JOBS_GENERATE_ENDPOINT=/api/v1/jobs/createTask
KIE_JOBS_STATUS_ENDPOINT=/api/v1/jobs/recordInfo
KIE_ALEPH_STATUS_ENDPOINT=/api/v1/aleph/record-detail
KIE_RUNWAY_STATUS_ENDPOINT=/api/v1/runway/record-detail

# Video Editing (Shotstack - Free 7200s/month)
SHOTSTACK_API_KEY_ID=your-shotstack-key-id
SHOTSTACK_API_SECRET=your-shotstack-secret

# Prompt Lens V2 Workflow
FFMPEG_WORKER_URL=
FFMPEG_WORKER_SECRET=
BYOK_ENCRYPTION_KEY=

# Payments - overseas card checkout via Creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_PRODUCT_STARTER_10=
CREEM_PRODUCT_STUDIO_80=
CREEM_PRODUCT_PRO_220=

