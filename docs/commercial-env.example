# Server-only template. Do not paste secrets into chat or commit configured copies.
# Existing database/auth/R2 variables are still required.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_SANDBOX=false
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.example/api/payments/webhooks/alipay
KIE_API_KEY=
FFMPEG_WORKER_URL=
FFMPEG_WORKER_SECRET=
CRON_SECRET=

# Also set CRON_SECRET and this HTTPS origin on the FFmpeg worker.
COMMERCIAL_RECONCILIATION_BASE_URL=https://your-domain.example

# Remain disabled until deployment and verification.
COMMERCIAL_CONSUMPTION_ENABLED=false
COMMERCIAL_REWRITE_ENABLED=false
COMMERCIAL_MIGRATION_ACCEPTED=
COMMERCIAL_SCHEDULER_ACCEPTED=false
COMMERCIAL_PAYMENT_ACCEPTANCE=
COMMERCIAL_MODEL_ACCEPTANCE=
